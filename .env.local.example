# Your free Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here_no_quotes

# ── Fallback tier 2: free external providers (optional) ─────────────────
# Without these keys the tier is skipped automatically.
# Groq — very fast, generous free tier: https://console.groq.com
# GROQ_API_KEY=your_groq_key
# Comma-separated model list (default: openai/gpt-oss-120b,openai/gpt-oss-20b)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Mistral — most permissive content policy, beautiful prose, slower free tier:
# https://console.mistral.ai — tried after Groq; first for LONG campaigns
# (their JSON exceeds Groq's 4096-token cap). Own 120s timeout.
# MISTRAL_API_KEY=your_mistral_key
# MISTRAL_MODELS=mistral-large-latest
# Cerebras — optional, same OpenAI-compatible mechanism: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=your_cerebras_key

# ── Tier 3: local Ollama as the last-resort safety net (no key needed) ──
# Defaults below are sensible; change only if you host Ollama elsewhere.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_TIMEOUT_MS=180000
